// Spec 0001 §🧬: sightings are the atom, the dex is a view. Superset of spike/ui/src/types.ts (handoff 0004 S5).
// "Seen 14 times, first in March" is derived from Sighting, never stored. Studied + seen per taxon are derived too.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity ──────────────────────────────────────────────────────────────────

/// Anonymous first (record Q3). Minted on first request, bound to a cookie. Passkeys attach later (handoff 0006).
/// Deletion is a hard cascade: no deletedAt.
model Identity {
  id            String     @id @default(uuid())
  createdAt     DateTime   @default(now())
  /// The verified address (handoff 0020): the second recovery path next to passkeys. Set only by `identity.emailVerify`,
  /// together with `emailVerifiedAt`; PII (spec §⚖️), on the identity, in the export and in the mail, nowhere else.
  email           String?    @unique
  emailVerifiedAt DateTime?
  /// Name and photo are optional private profile data, never on a share card (spec §⚖️).
  displayName   String?
  /// The profile photo (handoff 0014 P2): one user Asset per identity, square, ≤ 256 px, served by /api/photo/<id>.
  /// Replaced on re-upload (the old Asset and its file go), gone with the identity. Never on a share card.
  avatar        Asset?     @relation("avatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  avatarAssetId String?    @unique
  passkeys      Passkey[]
  emailCodes    EmailCode[]
  filter        Filter?
  sightings     Sighting[]
  studies       Study[]
  assets        Asset[]
}

/// One six-digit code per attach attempt (handoff 0020 E1), hashed at rest (SHA-256), 10 minutes, 5 tries.
/// One live code per identity: a new `emailStart` marks the old one used. Gone with the identity.
model EmailCode {
  id         String    @id @default(uuid())
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId String
  /// Lower-cased, trimmed; the address the code went to.
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  /// de | en: the language the mail was written in.
  locale     String

  @@index([identityId])
  @@index([email, createdAt])
}

/// One WebAuthn credential per device. Anonymous = zero rows; "Auf N Geräten" = N rows.
model Passkey {
  id           String    @id @default(uuid())
  identity     Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId   String
  /// Base64url credential id as the authenticator reports it.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([identityId])
}

/// The global filter: region, tiles, the "nur jetzt" chip. One per identity; set during onboarding.
/// The month is a sort, never membership (record 0002 E2): no Zeitraum here.
model Filter {
  id         String   @id @default(uuid())
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId String   @unique
  /// The active region (handoff 0018): the grid, the counters, the scan's set. Always one of `regionIds`.
  region     Region?  @relation(fields: [regionId], references: [id])
  regionId   String?
  /// The identity's regions (handoff 0018 R1), ready ones only; the sheet "Meine Regionen" switches among them.
  regionIds  String[] @default([])
  tiles      Tile[]
  /// Chip "nur jetzt": share ≥ 25 % of peak this month. Off by default.
  nowOnly    Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

// ── Species data (written by the ETL, M4) ─────────────────────────────────────

/// Eight tiles from GBIF ranks (record 0002 E5, E12). 🐟 is stored for every region and hidden when the set has none.
enum Tile {
  bird
  mammal
  amphibian
  reptile
  fish
  insect
  plant
  fungus
}

enum RegionStatus {
  unprepared
  queued
  ready
  failed
}

/// One application-facing region. Legacy rows retain their UUID and may have only a GADM bridge;
/// versioned registries attach stable product identity and composite source/query units additively.
model Region {
  id           String       @id @default(uuid())
  /// Legacy single-query bridge. New registry regions use RegionQueryUnit rows instead.
  gadmGid      String?      @unique
  /// Stable public identity such as `de-krg-07340000`; null until a legacy row is mapped.
  canonicalKey String?      @unique
  /// ISO 3166-1 alpha-2 code; null on unmapped legacy rows.
  countryCode  String?
  name         String
  /// country › state, e.g. "Deutschland › Rheinland-Pfalz".
  higher       String
  /// All observations per month, 12 entries; the denominator of every month share.
  monthTotals  Int[]        @default([])
  /// Compatibility picker counts refreshed with live regional publication, never during reads.
  pickerSummary Json?
  status       RegionStatus @default(queued)
  /// The last failed facet's message; null when ready.
  error        String?
  refreshedAt  DateTime?
  createdAt    DateTime     @default(now())

  plausibility    Plausibility[]
  lookalikes      Lookalike[]
  filters         Filter[]
  registryEntries RegionRegistryEntry[]

  @@index([countryCode])
}

enum RegionRegistrySourceRole {
  regions
  kreisUnits
  queryMappings
}

enum RegionAliasKind {
  displayName
  sourceName
  sourceUnit
  state
  variant
}

enum RegionQueryProvider {
  gbifGadm
}

enum RegionQueryReviewStatus {
  pending
  verified
  rejected
}

/// One immutable, importable snapshot of a country's official region registry.
/// A raw partial unique index in the migration permits at most one active version per country.
model RegionRegistryVersion {
  id                  String    @id @default(uuid())
  countryCode         String
  version             String
  artifactSha256      String
  expectedRegions     Int
  expectedSourceUnits Int
  active              Boolean   @default(false)
  importedAt          DateTime  @default(now())
  activatedAt         DateTime?

  sources     RegionRegistrySource[]
  entries     RegionRegistryEntry[]
  sourceUnits RegionSourceUnit[]
  queryUnits  RegionQueryUnit[]
  catalogues  CatalogueVersion[]

  @@unique([countryCode, version])
  @@index([countryCode, active])
}

/// A pinned input and its complete provenance/licence record within one registry version.
model RegionRegistrySource {
  id                String                   @id @default(uuid())
  registryVersion   RegionRegistryVersion    @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  registryVersionId String
  role              RegionRegistrySourceRole
  name              String
  url               String
  topicDate         DateTime                 @db.Date
  downloadedAt      DateTime
  sha256            String
  licenceId         String
  licenceUrl        String?
  attribution       String
  metadata          Json?

  entries     RegionRegistryEntry[]
  sourceUnits RegionSourceUnit[]
  queryUnits  RegionQueryUnit[]

  @@unique([id, registryVersionId])
  @@unique([registryVersionId, role])
}

/// A selectable region as it appears in one registry version.
model RegionRegistryEntry {
  id                String                @id @default(uuid())
  registryVersion   RegionRegistryVersion @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  registryVersionId String
  source            RegionRegistrySource  @relation(fields: [sourceId, registryVersionId], references: [id, registryVersionId], onDelete: Restrict)
  sourceId          String
  region            Region                @relation(fields: [regionId], references: [id], onDelete: Restrict)
  regionId          String
  sourceCode        String
  sourceName        String
  displayName       String
  stateCode         String
  stateName         String

  aliases     RegionRegistryAlias[]
  sourceUnits RegionSourceUnit[]
  catalogueBuilds CatalogueRegionBuild[]

  @@unique([id, registryVersionId])
  @@unique([registryVersionId, sourceCode])
  @@unique([registryVersionId, regionId])
  @@index([sourceId])
}

/// One normalized search term for a versioned selectable region.
model RegionRegistryAlias {
  id              String              @id @default(uuid())
  registryEntry   RegionRegistryEntry @relation(fields: [registryEntryId], references: [id], onDelete: Restrict)
  registryEntryId String
  kind            RegionAliasKind
  name            String
  normalizedName  String

  @@unique([registryEntryId, normalizedName])
  @@index([normalizedName])
}

/// One authoritative constituent Kreis assigned to exactly one region in a registry version.
model RegionSourceUnit {
  id                String                @id @default(uuid())
  registryVersion   RegionRegistryVersion @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  registryVersionId String
  registryEntry     RegionRegistryEntry   @relation(fields: [registryEntryId, registryVersionId], references: [id, registryVersionId], onDelete: Restrict)
  registryEntryId   String
  source            RegionRegistrySource  @relation(fields: [sourceId, registryVersionId], references: [id, registryVersionId], onDelete: Restrict)
  sourceId          String
  canonicalKey      String
  sourceCode        String
  name              String
  kind              String

  queryUnits RegionQueryUnit[]

  @@unique([id, registryVersionId])
  @@unique([registryVersionId, canonicalKey])
  @@unique([registryVersionId, sourceCode])
  @@index([registryEntryId])
  @@index([sourceId])
}

/// One provider-specific occurrence query unit mapped to a constituent Kreis.
model RegionQueryUnit {
  id                String                  @id @default(uuid())
  registryVersion   RegionRegistryVersion   @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  registryVersionId String
  sourceUnit        RegionSourceUnit        @relation(fields: [sourceUnitId, registryVersionId], references: [id, registryVersionId], onDelete: Restrict)
  sourceUnitId      String
  source            RegionRegistrySource    @relation(fields: [sourceId, registryVersionId], references: [id, registryVersionId], onDelete: Restrict)
  sourceId          String
  provider          RegionQueryProvider
  providerVersion   String
  providerKey       String
  reviewStatus      RegionQueryReviewStatus @default(pending)
  reviewedAt        DateTime?
  evidence          Json

  @@unique([registryVersionId, provider, providerVersion, providerKey], map: "RegionQueryUnit_registry_provider_key")
  @@index([sourceUnitId])
  @@index([sourceId])
}

enum CatalogueStatus {
  building
  partial
  complete
  audited
  active
  retired
}

enum CatalogueRegionBuildStatus {
  pending
  running
  complete
  failed
}

enum TaxonEnrichmentWorkStatus {
  pending
  running
  complete
  failed
}

/// One resumable, inspectable national catalogue candidate. A run key identifies resume intent;
/// starting a refresh uses a new key even when the pinned registry and rules are unchanged.
model CatalogueVersion {
  id                       String                @id @default(uuid())
  countryCode              String
  runKey                   String
  registryVersion          RegionRegistryVersion @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  registryVersionId        String
  inputFingerprint         String
  sourceFingerprint        String
  responseFingerprint      String?
  unionFingerprint         String?
  plausibleRulesVersion    Int
  tileMappingVersion       Int
  /// 0 denotes historical catalogues predating the explicit marine exclusion rule.
  habitatRulesVersion      Int                   @default(0)
  habitatSource            Json?
  observationWindowVersion Int
  yearFrom                 Int
  yearTo                   Int
  occurrencePredicates     Json
  status                   CatalogueStatus       @default(partial)
  expectedRegions          Int
  completedRegions         Int                   @default(0)
  unionTaxa                Int                   @default(0)
  startedAt                DateTime              @default(now())
  generatedAt              DateTime?
  auditedAt                DateTime?
  activatedAt              DateTime?
  executionOwner           String?
  executionExpiresAt       DateTime?
  updatedAt                DateTime              @updatedAt

  regionBuilds CatalogueRegionBuild[]
  taxa         CatalogueTaxon[]
  taxonomy     CatalogueTaxonomyResolution[]
  habitat      CatalogueHabitatBatch[]

  @@unique([countryCode, runKey])
  @@unique([id, registryVersionId])
  @@index([countryCode, status])
  @@index([registryVersionId])
}

/// Durable per-region checkpoint and summary. Its staged rows are invisible to product reads until
/// a later audited cutover activates the catalogue as a whole.
model CatalogueRegionBuild {
  id                  String                     @id @default(uuid())
  catalogueVersion    CatalogueVersion           @relation(fields: [catalogueVersionId, registryVersionId], references: [id, registryVersionId], onDelete: Restrict)
  catalogueVersionId  String
  registryVersionId   String
  registryEntry       RegionRegistryEntry        @relation(fields: [registryEntryId, registryVersionId], references: [id, registryVersionId], onDelete: Restrict)
  registryEntryId     String
  status              CatalogueRegionBuildStatus @default(pending)
  attempts            Int                        @default(0)
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  error               String?
  totalObservations   Int?
  monthTotals         Int[]                      @default([])
  regionSize          Int?
  /// Precomputed seasonal membership counts; empty on older builds until regenerated.
  nowCounts           Int[]                      @default([])
  perTile             Json?
  rejectedTaxa        Json?
  habitatSummary      Json?
  requestStats        Json?
  responseFingerprint String?
  setFingerprint      String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  plausibility CataloguePlausibility[]
  lookalikes   CatalogueLookalike[]

  @@unique([catalogueVersionId, registryEntryId])
  @@index([catalogueVersionId, status, leaseExpiresAt])
  @@index([registryEntryId])
}

/// Candidate regional membership, versioned separately from the live Plausibility table.
model CataloguePlausibility {
  id            String               @id @default(uuid())
  regionBuild   CatalogueRegionBuild @relation(fields: [regionBuildId], references: [id], onDelete: Cascade)
  regionBuildId String
  taxon         Taxon                @relation(fields: [taxonId], references: [id], onDelete: Restrict)
  taxonId       String
  obs           Int
  monthShare    Int[]
  peak          Int
  words         String

  @@unique([regionBuildId, taxonId])
  @@index([taxonId])
}

/// Candidate same-genus relation derived only from a completed staged regional set.
model CatalogueLookalike {
  id            String               @id @default(uuid())
  regionBuild   CatalogueRegionBuild @relation(fields: [regionBuildId], references: [id], onDelete: Cascade)
  regionBuildId String
  taxon         Taxon                @relation("catalogueLookalikeOf", fields: [taxonId], references: [id], onDelete: Restrict)
  taxonId       String
  sibling       Taxon                @relation("catalogueLookalikeSibling", fields: [siblingId], references: [id], onDelete: Restrict)
  siblingId     String

  @@unique([regionBuildId, taxonId, siblingId])
  @@index([taxonId])
  @@index([siblingId])
}

/// The accepted-key union of staged, completed regional sets. This is the deduplicated handoff to
/// global content/gallery phases; it is never a taxon-region work queue.
model CatalogueTaxon {
  catalogueVersion   CatalogueVersion @relation(fields: [catalogueVersionId], references: [id], onDelete: Restrict)
  catalogueVersionId String
  taxon              Taxon            @relation(fields: [taxonId], references: [id], onDelete: Restrict)
  taxonId            String
  createdAt          DateTime         @default(now())

  @@id([catalogueVersionId, taxonId])
  @@index([taxonId])
}

/// One fetched GBIF taxonomy record and its deterministic accepted/rejected resolution within a
/// catalogue run. The record envelope also checkpoints a reviewed 404 without using SQL null.
model CatalogueTaxonomyResolution {
  catalogueVersion   CatalogueVersion @relation(fields: [catalogueVersionId], references: [id], onDelete: Restrict)
  catalogueVersionId String
  sourceKey          Int
  record             Json
  recordFingerprint  String
  acceptedKey        Int?
  rejectionReason    String?
  resolvedAt         DateTime         @default(now())

  @@id([catalogueVersionId, sourceKey])
  @@index([acceptedKey])
}

/// Local bounded WoRMS match evidence. Raw response envelopes are never product API payloads.
model CatalogueHabitatBatch {
  catalogueVersion   CatalogueVersion @relation(fields: [catalogueVersionId], references: [id], onDelete: Restrict)
  catalogueVersionId String
  requestFingerprint String
  names              String[]
  record             Json
  recordFingerprint  String
  resolvedAt         DateTime         @default(now())

  @@id([catalogueVersionId, requestFingerprint])
  @@index([names], type: Gin)
}

/// Phase/version-specific global work checkpoint. It is keyed by global taxon identity rather
/// than catalogue membership, so #20 can reuse completed gallery work across future catalogues.
model TaxonEnrichmentWork {
  taxon             Taxon                     @relation(fields: [taxonId], references: [id], onDelete: Restrict)
  taxonId           String
  kind              String
  version           String
  status            TaxonEnrichmentWorkStatus @default(pending)
  attempts          Int                       @default(0)
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  error             String?
  resultSummary     Json?
  sourceFingerprint String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@id([taxonId, kind, version])
  @@index([kind, version, status, leaseExpiresAt])
}

/// One row per GBIF backbone taxon the app has touched: set members and species logged outside every set (E13).
model Taxon {
  id          String    @id @default(uuid())
  gbifKey     Int       @unique
  wikidataId  String?   @unique
  sciName     String
  /// Common names per language: { "de": "Amsel", "en": "Common Blackbird" }. German from the dewiki title (E6).
  commonNames Json      @default("{}")
  rank        String
  tile        Tile
  /// GBIF ranks the tile was derived from; genus drives look-alikes (E10).
  class       String?
  order       String?
  genus       String?
  /// IUCN category code (LC, NT, VU, EN, CR …), null when unknown.
  iucn        String?
  tags        String[]  @default([])
  /// Wikipedia intro: { text, lang, source, licence }. de → en → null. CC BY-SA until rewritten from facts (E8).
  intro       Json?
  /// Steckbrief (E8, handoff 0021 D2): `{ key: { value, source, url?, licence? } }`. AnAge keys from the content job;
  /// mass, wingspan, length, migration, habitat, diet, activity, flowering, height, pollination, lifeform, edibility,
  /// sporePrint from the `facts` step (AVONET, EltonTraits, PanTHERIA, AmphiBIO, GIFT, Wikidata). Enum-like values are
  /// codes the client translates; numbers are metric strings with an ASCII decimal point.
  facts       Json?
  /// Set when the `facts` step has run for this taxon (0021 D1); the later prose step rewrites when facts are newer.
  factsAt     DateTime?
  /// Handoff 0028: the Steckbrief and Ökologie prose written from the fact sheet by the `prose` step (etl/prose):
  /// `{ version: 1, regions: { [regionId]: { de, en, eco, facts, inputHash, model, judged, at } } }`; null until written.
  prose       Json?
  /// How the Wikidata item was found: P846 | name | none.
  namePath    String?
  /// Set when the content job has run for this taxon; never expires, purge only.
  contentAt   DateTime?
  updatedAt   DateTime  @updatedAt

  assets           Asset[]
  sightings        Sighting[]
  studies          Study[]
  plausibility     Plausibility[]
  lookalikes       Lookalike[]    @relation("lookalikeOf")
  lookalikeSibling Lookalike[]    @relation("lookalikeSibling")
  interactionsFrom Interaction[]  @relation("source")
  interactionsTo   Interaction[]  @relation("target")
  cataloguePlausibility CataloguePlausibility[]
  catalogueLookalikes CatalogueLookalike[] @relation("catalogueLookalikeOf")
  catalogueLookalikeSiblings CatalogueLookalike[] @relation("catalogueLookalikeSibling")
  catalogues CatalogueTaxon[]
  enrichmentWork TaxonEnrichmentWork[]
}

/// Membership in a region's set, whole year, cut per tile (record 0002 E2, E3). GBIF alone.
model Plausibility {
  id         String @id @default(uuid())
  taxon      Taxon  @relation(fields: [taxonId], references: [id], onDelete: Cascade)
  taxonId    String
  region     Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId   String
  /// Observations over the whole window (last ten years).
  obs        Int
  /// Share of the region's observations per month, 12 entries, per 100,000 (per mille rounds species under ~50 records to 0; routers return per mille).
  monthShare Int[]
  /// The largest month share, same unit; nowRatio = monthShare[m] ÷ peak is derived.
  peak       Int
  /// "Ganzes Jahr" · "Mär–Okt" · "Feb · Okt–Dez".
  words      String

  @@unique([taxonId, regionId])
  @@index([regionId])
}

/// Same genus within the region's set (record 0002 E10). Both directions are stored.
model Lookalike {
  taxon     Taxon  @relation("lookalikeOf", fields: [taxonId], references: [id], onDelete: Cascade)
  taxonId   String
  region    Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId  String
  sibling   Taxon  @relation("lookalikeSibling", fields: [siblingId], references: [id], onDelete: Cascade)
  siblingId String

  @@id([taxonId, regionId, siblingId])
}

enum InteractionKind {
  eats
  eatenBy
  pollinates
  hostOf
  parasiteOf
  visitsFlowersOf
}

/// GloBI, pruned to six kinds; preysOn folds into eats at import (record 0002 E9). The ecology section and, later, the quest generator.
model Interaction {
  id       String          @id @default(uuid())
  source   Taxon           @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String
  target   Taxon           @relation("target", fields: [targetId], references: [id], onDelete: Cascade)
  targetId String
  kind     InteractionKind
  /// Where the record came from, e.g. "GloBI".
  origin   String
  /// Handoff 0028 (0027 F1): the GloBI studies behind the edge, `{ "<study citation>": records }`; `{}` on an edge fetched before 0028.
  studies  Json            @default("{}")
  /// Records not from a metaweb (0027 F1); 0 on an edge fetched before 0028.
  real     Int             @default(0)
  /// False when F1 (eats/eatenBy, all studies metawebs) or F2 (≤ 1 real record from ≤ 1 real study) drops the edge from the prose sheet; the tile keeps it.
  prose    Boolean         @default(true)

  @@unique([sourceId, targetId, kind])
}

enum AssetKind {
  image
  sound
}

/// Every image and sound carries its licence and attribution (spec §🗄️ §⚖️). Reference assets belong to a taxon,
/// user photos to a sighting.
model Asset {
  id         String    @id @default(uuid())
  kind       AssetKind @default(image)
  url        String
  /// Rendered under every image view.
  author     String
  licence    String
  licenceUrl String?
  /// The page the asset was taken from (Commons file page, iNat observation, Xeno-canto recording).
  sourceUrl  String
  /// commons | inat | xeno-canto | user
  origin     String
  caption    String?
  /// Per-kind extras (0021 D5): a sound carries `{ xcId, type, length, quality }` from xeno-canto. Null on images.
  meta       Json?
  /// Stable gallery order for taxon-owned reference images; position zero remains every legacy lead.
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  taxon      Taxon?    @relation(fields: [taxonId], references: [id], onDelete: Cascade)
  taxonId    String?
  sighting   Sighting? @relation(fields: [sightingId], references: [id], onDelete: Cascade)
  sightingId String?
  owner      Identity? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String?
  /// Set when this user photo is an identity's avatar (0014 P2); such an asset has no sighting and the sweep leaves it alone.
  avatarOf   Identity? @relation("avatar")
  /// Legacy photos conservatively count as the previous 8 MiB upload maximum.
  byteSize   Int       @default(8388608)
  scans      ScanWork[]

  @@index([taxonId])
  @@index([taxonId, position])
}

// ── The atom and the other axis ───────────────────────────────────────────────

enum Evidence {
  claimed
  photographed
  idAssisted
}

enum Wildness {
  wild
  captive
  cultivated
}

/// Every encounter is a record; a species is discovered on its first wild sighting.
model Sighting {
  id         String   @id @default(uuid())
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId String
  taxon      Taxon    @relation(fields: [taxonId], references: [id])
  taxonId    String
  at         DateTime
  /// Exact, stored on the device and here; coarsened on every list and on share (spec §⚖️).
  lat        Float?
  lng        Float?
  /// Gemeinde label shown on lists.
  place      String?
  note       String?
  evidence   Evidence @default(claimed)
  /// Captive and cultivated sightings never fill the dex.
  wildness   Wildness @default(wild)
  createdAt  DateTime @default(now())
  photos     Asset[]

  @@index([identityId, at])
  @@index([identityId, taxonId])
}

/// Marked studied. XP for it is paid only after the recap (record Q8c).
model Study {
  id          String   @id @default(uuid())
  identity    Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId  String
  taxon       Taxon    @relation(fields: [taxonId], references: [id])
  taxonId     String
  at          DateTime @default(now())
  recapPassed Boolean  @default(false)

  @@unique([identityId, taxonId])
}

/// Admission counters survive process restarts and identity deletion.
model QuotaBucket {
  key String @id
  value Int
  expiresAt DateTime
  @@index([expiresAt])
}
model ScanWork {
  key String @id
  photoId String
  photo Asset @relation(fields: [photoId], references: [id], onDelete: Cascade)
  identityId String
  token String
  leaseUntil DateTime
  result Json?
  @@index([leaseUntil])
  @@index([identityId, leaseUntil])
}
/// No relation: work must survive deletion of the identity, sighting and asset.
model PhotoDeletion {
  assetId String @id
  createdAt DateTime @default(now())
  @@index([createdAt])
}
