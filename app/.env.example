# Local development only. Never point a local server at the Neon production database.
DATABASE_URL=postgresql://dex:dex@localhost:5433/dex
DATABASE_URL_UNPOOLED=postgresql://dex:dex@localhost:5433/dex
PHOTO_DIR=./data/photos
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Replace for real deployment; at least 32 characters.
WEBAUTHN_SECRET=dev-only-secret-not-for-production

# Production: Vercel Node 24, Neon Postgres, private Vercel Blob. See docs/DEPLOY.md.
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=
# ANTHROPIC_API_KEY=    production scan key; never use for scripts/ETL
# RESEND_API_KEY=
# Test-only service stubs (never set these in production):
# ANTHROPIC_BASE_URL=http://127.0.0.1:9
# RESEND_BASE_URL=http://127.0.0.1:9

# Durable anonymous-use allowances; defaults shown. Zero closes that capability.
# SCAN_IDENTITY_DAILY=20
# SCAN_NETWORK_DAILY=100
# SCAN_GLOBAL_DAILY=500
# SCAN_GLOBAL_CONCURRENCY=4
# SCAN_DAILY_BUDGET_CENTS=1000
# SCAN_MONTHLY_BUDGET_CENTS=30000
# UPLOAD_IDENTITY_DAILY=50
# UPLOAD_NETWORK_DAILY=200
# UPLOAD_GLOBAL_DAILY=2000
# UPLOAD_IDENTITY_STORAGE_BYTES=268435456
# UPLOAD_GLOBAL_STORAGE_BYTES=10737418240
# Only configure when your reverse proxy overwrites this header; never trust arbitrary client headers.
# TRUST_PROXY_IP_HEADER=x-real-ip

# Experimental static export API base; insufficient by itself for cross-origin/native hosting.
# NEXT_PUBLIC_API_URL=
